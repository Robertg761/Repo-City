# Copy to .env.local and fill in. Never commit .env.local.
# Every variable here is server-side only; none of them is exposed with NEXT_PUBLIC_.

# Required. Fine-grained PAT, public repository read only, no other permissions.
GITHUB_TOKEN=

# Optional runtime architecture interpretation. `none` is the default and the
# setting the hosted demo runs with; the city is built deterministically either way.
AI_PROVIDER=none          # none | anthropic | openai | google | openai-compatible
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=              # openai-compatible only
AI_MAX_PER_HOUR=60        # AI calls per instance per hour; over the cap, interpretation is skipped

# Serve a committed fixtures/*.analysis.json snapshot when GitHub rate-limits a
# demo repository. Opt-in: leaving this unset turns the fallback OFF, so a
# deployment that wants it must set it explicitly.
FIXTURE_FALLBACK=true
